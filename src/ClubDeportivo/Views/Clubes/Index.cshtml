@model IEnumerable<ClubDeportivo.Application.Dtos.ClubDto>
@{ ViewData["Title"] = "Clubes"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Clubes</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar club</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th><h3>Nombre</h3></th>
                <th><h3>Deporte</h3></th>
                <th><h3>Ubicación</h3></th>
                <th><h3>Fecha de fundación</h3></th>
                <th><h3>Miembros activos</h3></th>
                <th><h3>Acciones</h3></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Nombre</td>
                <td>@x.Deporte</td>
                <td>@x.Ubicacion</td>
                <td>@x.FechaFundacion.ToString("dd/MM/yyyy")</td>
                <td class="text-center">@x.MiembrosActivos</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>