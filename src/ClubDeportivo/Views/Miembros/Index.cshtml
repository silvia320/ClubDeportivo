@model IEnumerable<ClubDeportivo.Application.Dtos.MiembroDto>
@{ ViewData["Title"] = "Miembros"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Miembros</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar miembro</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th><h3>Nombre</h3></th>
                <th><h3>Apellido</h3></th>
                <th><h3>Correo</h3></th>
                <th><h3>Teléfono</h3></th>
                <th><h3>Clubes activos</h3></th>
                <th><h3>Acciones</h3></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.Nombre</td>
                <td>@x.Apellido</td>
                <td>@x.Email</td>
                <td>@x.Telefono</td>
                <td class="text-center">@x.ClubesActivos</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>