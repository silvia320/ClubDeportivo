@model IEnumerable<ClubDeportivo.Application.Dtos.InscripcionDto>
@{ ViewData["Title"] = "Inscripciones"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Inscripciones</h2>
    <button type="button" class="btn btn-primary" data-modal-url="@Url.Action("Create")">Agregar inscripción</button>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th><h3>Club</h3></th>
                <th><h3>Miembro</h3></th>
                <th><h3>Fecha de inscripción</h3></th>
                <th><h3>Estado</h3></th>
                <th><h3>Acciones</h3></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var x in Model)
        {
            <tr>
                <td>@x.ClubTexto</td>
                <td>@x.MiembroTexto</td>
                <td>@x.FechaInscripcion.ToString("dd/MM/yyyy")</td>
                <td>@(x.Estado switch { "A" => "Activa", "S" => "Suspendida", "I" => "Inactiva", _ => x.Estado })</td>
                <td class="text-end text-nowrap">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-modal-url="@Url.Action("Edit", new { id = x.Id })">Editar</button>
                    <button type="button" class="btn btn-sm btn-outline-danger" data-modal-url="@Url.Action("Delete", new { id = x.Id })">Eliminar</button>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>